# VCS
.git
.gitignore

# Dependencies and package-manager state
node_modules
.pnpm-store

# Build output and caches
.turbo
dist
coverage
.cache
tsconfig.tsbuildinfo
v10

# Local environment files. `**/` because .dockerignore patterns are anchored
# to the context root: a bare `.env` misses apps/ui/.env, which Vite then
# reads at build time and bakes into the bundle.
**/.env
**/.env.*
!**/.env.example
# Gitignored local stand-in for the chart's runtime config. Baked into the
# image it overrides VITE_NETWORK_NAME and pins the UI to the wrong network.
apps/ui/public/config.js
.DS_Store

# Editor / tooling
.idea
.vscode

# Agent and analysis metadata
.agents
.codacy
.cursor
AGENTS.md

# Local-only scratch data
.fastembed_cache
draft

# Existing app/package artifacts
apps/*/dist
apps/*/.astro
apps/*/.vite
apps/*/coverage
packages/*/dist
