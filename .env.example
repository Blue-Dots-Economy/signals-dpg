# Secrets are resolved in packages/config/src/secrets.ts

# ─── Instance ───
INSTANCE_NAME="dpg"
# development locally, production on a server with a domain
INSTANCE_ENV="development"
API_DOMAIN='http://localhost'
API_PORT="2742"

# /api/reference docs; off in production unless forced
API_REFERENCE_ENABLED=true
API_REFERENCE_FORCE=false

AUTH_SECRET="CHANGE_ME_run_openssl_rand_hex_32"
ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# network_id/domain_id, comma separated
SERVED_DOMAINS="blue_dot/seeker,blue_dot/provider"

# Split portals: host=network/domain, semicolon separated. Empty = single host.
UI_HOST_BINDINGS=""
# UI_HOST_BINDINGS="providers-signals.example.org=blue_dot/provider;seekers-signals.example.org=blue_dot/seeker"
# UI_HOST_BINDINGS="http://localhost:5174=blue_dot/seeker;http://localhost:5175=blue_dot/provider"

# ─── Network config ───
# local (file) or remote (NETWORK_CONFIG_URLS / SCHEMA_REGISTRY_URL)
NETWORK_CONFIG_SOURCE="local"
NETWORK_CONFIG_LOCAL_FILE="../../examples/schemas/blue_dot/network.json"
# NETWORK_CONFIG_URLS="onest_yellow_dot=https://registry.example.com/yellow-dot/network.json"
# Base URL, or network_id=url pairs
SCHEMA_REGISTRY_URL='onest_yellow_dot=https://registry.example.com/schemas/yellow_dot/network.json,blue_dot=https://registry.other.example.com/schemas/blue_dot/network.json'
# false skips the boot-time schema cache warmup (used by spec:dump)
SCHEMA_CACHE_WARMUP_ENABLED="true"
ALLOW_EXTRA_SCHEMA_DATA=false

# Replaces __SUPPORT_EMAIL__ in consent copy
CONSENT_SUPPORT_EMAIL="hello@bluedotseconomy.org"

# ─── Bulk and export limits (defaults shown) ───
# BULK_MAX_ITEMS=100
# EXPORT_MAX_ROWS=10000
# EXPORT_TIMEZONE=Asia/Kolkata
# EXPORT_RATE_LIMIT_PER_HOUR=20

# ─── Postgres ───
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="dev-postgres-password-change-me"
POSTGRES_DB="postgresdb"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
DATABASE_PORT=5432
# POSTGRES_URL="postgres://user:password@host:5432/dbname"

# ─── Redis ───
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD="dev-redis-password-change-me"
REDIS_PORT=5555
# REDIS_URL="redis://:password@host:6379"

# ─── Notification service (needed when CREATE_TEST_OTP is off) ───
# NOTIFICATION_SERVICE_ENDPOINT=
# NOTIFICATION_SERVICE_KEY_ID=
# NOTIFICATION_SERVICE_SECRET=
# SMS_TEMPLATE_ID=

# ─── signals-search (discover ranking + match score) ───
# Set both URLs or one feature stays off. Port 3100 (3110 in aggregator local-setup).
# SIGNALS_SEARCH_URL=http://localhost:3100
# MATCH_SCORE_PROVIDER=signals_search
# SIGNALS_SEARCH_ENDPOINT=http://localhost:3100
# SIGNALS_SEARCH_API_KEY=
# SIGNALS_SEARCH_RELEVANCE_PATH=v1/relevance
# SIGNALS_SEARCH_DISTANCE_METERS=30000
# Free-text match score badge on /discover
# VITE_FREETEXT_MATCH_SCORE_ENABLED=true

# ─── Feature flags (empty = false) ───
CREATE_TEST_OTP=true
AUTH_MIDDLEWARE_ENABLED=true

# openssl rand -base64 32
SIGNALS_PII_KEY='<replace-me>'

# ─── Geocoding ───
# Google if a key is set, else Photon
GOOGLE_GEOCODING_API_KEY=
PHOTON_URL=
GEO_CACHE_TTL_SECONDS=2592000
GEO_CACHE_NEGATIVE_TTL_SECONDS=3600
# Total tries on transient errors, and pause between them
GEO_RETRY_ATTEMPTS=2
GEO_RETRY_BACKOFF_MS=300
# Geocode endpoint used by signals-search (daily cap = live provider calls)
GEO_RESOLVE_TIMEOUT_MS=1500
GEO_RESOLVE_DAILY_CAP=5000
GEO_RESOLVE_CLIENT_IDS=signals-search-client

# ─── UI: map ───
# leaflet, google-maps or mapbox
VITE_MAP_PROVIDER=leaflet
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
# Address autocomplete when no Google key
VITE_PHOTON_URL=
# Empty = whole India. e.g. 12.9716,77.5946
VITE_MAP_DEFAULT_CENTER=
VITE_MAP_DEFAULT_ZOOM=12
# Radius-only map fetch cap (max 25000)
VITE_MAP_FETCH_LIMIT=25000
# Map marker caps by zoom band (runtime)
VITE_MAP_MARKER_CAP_CLUSTERED=1000
VITE_MAP_MARKER_CAP_INDIVIDUAL=500
VITE_MAP_CLUSTER_DISABLE_ZOOM=14
VITE_MAP_CLUSTER_ZOOM_ANIM_MS=2000
VITE_MAP_POPUP_Z_INDEX=1000000

# ─── UI: API ───
VITE_API_URL=http://localhost:2742
# Dev only, JSON: {"student":"http://localhost:3001"}
VITE_API_URLS=
# VITE_DEFAULT_API_URL=http://localhost:3000
# VITE_SHOW_INSTANCE_SELECTOR=true

# ─── UI: network and domain ───
# Empty shows the network selector
VITE_NETWORK_ID=blue_dot
# Pin this UI to network/domain values; unset = all domains
# VITE_SERVED_BINDINGS=purple_dot/provider
# VITE_DEFAULT_NETWORK_THEME=purple_dot
# VITE_TOURIST_APP_TITLE=OneTAC
VITE_DEFAULT_BRAND=standard
# VITE_ENABLED_LANGUAGES=en,kn,hi

# ─── UI: credential import ───
VITE_VC_WALLET_URL=
VITE_VC_WALLET_API_KEY=
# DigiLocker (bridge page: docs/operations/digilocker-bridge.example.html)
VITE_AGENT_URL=
VITE_AGENT_TOKEN=

# ─── UI: lists ───
VITE_ACTION_POLL_INTERVAL_MS=30000
VITE_DEFAULT_VIEW_MODE=map
VITE_PROFILE_FETCH_LIMIT=1000
VITE_PROFILE_PAGE_SIZE=50

# ─── Sign-up and support ───
# allowed locally; gated for shared/prod
SELF_SIGNUP_MODE=allowed
LOGIN_CHANNELS=email,phone
# Unset hides the Contact support form
SUPPORT_EMAIL=support@example.org
SUPPORT_CC_EMAIL=
SUPPORT_ATTACHMENT_MAX_TOTAL_BYTES=5242880
SUPPORT_ATTACHMENT_MAX_FILES=3

# ─── Keycloak ───
AUTH_PROVIDER=keycloak
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_INTERNAL_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=bluedots
KEYCLOAK_UI_CLIENT_ID=signals-ui
KEYCLOAK_API_CLIENT_ID=signals-api
KEYCLOAK_API_CLIENT_SECRET=signals-api-dev-secret-change-me
KEYCLOAK_ACCEPTED_CLIENT_IDS=signals-ui
# Service-account clients; add signals-search-client for text-address search
# KEYCLOAK_SERVICE_CLIENT_IDS=signals-search-client
