# Example env for a purple_dot instance (local multi-instance test cluster).
# Copy to `.env.purple` and fill real values. `.env.purple` is gitignored.
# Secrets are marked <replace-me> — generate fresh per environment, never commit real values.

INSTANCE_NAME=purple_dot_ka
INSTANCE_ENV=local
API_DOMAIN=http://localhost
API_PORT=2742

# Secrets — generate fresh; do NOT reuse across environments.
AUTH_SECRET=<replace-me>
SECRETS_MASTER_KEY=<replace-me>
SIGNALS_PII_KEY=<replace-me>

SERVED_DOMAINS=purple_dot_ka
NETWORK_CONFIG_URLS=<network-config-url>
NETWORK_CONFIG_SOURCE=url
SCHEMA_REGISTRY_URL=<schema-registry-url>
ALLOW_EXTRA_SCHEMA_DATA=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace-me>
POSTGRES_DB=signals_purple
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_PORT=5432

REDIS_HOST=localhost
REDIS_PASSWORD=<replace-me>
REDIS_PORT=6379

CREATE_TEST_OTP=true
AUTH_MIDDLEWARE_ENABLED=true

VITE_API_URL=http://localhost:2742
VITE_NETWORK_ID=purple_dot
