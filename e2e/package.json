{
  "name": "signals-dpg-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "External black-box end-to-end functional test suite for signals-dpg. Runs against an already-running instance (local or dev) selected by a config file. Self-contained: not part of the pnpm workspace.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:api": "playwright test tests/api",
    "e2e:ui": "playwright test tests/ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "preflight": "playwright test tests/preflight",
    "coverage": "node scripts/check-coverage.mjs",
    "coverage:json": "node scripts/check-coverage.mjs --json",
    "coverage:baseline": "node scripts/check-coverage.mjs --update-baseline"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
