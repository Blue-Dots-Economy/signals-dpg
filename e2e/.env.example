# Copy to `.env` (gitignored) or export in your shell. These override config/<env>.json
# so no secrets need to be committed.

# Which environment config to load (config/<env>.json). Default: local
E2E_ENV=local

# Target URLs (override the config file)
# E2E_API_BASE_URL=http://localhost:2742
# E2E_UI_BASE_URL=http://localhost:5173

# Service-caller credentials (P5 network_service / P6 aggregator)
# E2E_SERVICE_API_KEY=
# E2E_ACTING_ORG_ID=

# Optional capabilities
# E2E_DB_URL=postgres://user:pass@localhost:5432/signals   # enables @needs-db tier
# E2E_NOTIFICATION_STUB_URL=http://localhost:9099          # inspectable notification sink
# E2E_PEER_API_BASE_URL=http://localhost:2743              # second peer instance (G3)

# Run tuning
# E2E_WORKERS=4
# E2E_RUN_ID=
