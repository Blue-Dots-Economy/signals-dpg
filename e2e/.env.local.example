# Copy to `e2e/.env.local` (gitignored) and fill in.
# Loaded automatically by run-e2e.sh when you run: /e2e local  (or bash e2e/run-e2e.sh local)
#
# Service credentials for the gated local instance. Mint them with:
#   POSTGRES_URL="postgres://<user>:<pass>@localhost:5432/signals" pnpm db:seed:services:api
E2E_SERVICE_API_KEY=
E2E_ACTING_ORG_ID=

# Optional URL overrides (otherwise config/local.json is used):
# E2E_API_BASE_URL=http://localhost:2742
# E2E_UI_BASE_URL=http://localhost:5173
