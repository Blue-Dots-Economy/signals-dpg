# VCS
.git
.gitignore

# Dependencies and package-manager state
node_modules
.pnpm-store

# Build output and caches
.turbo
dist
coverage
.cache

# Local environment files. `**/` because .dockerignore patterns are anchored
# to the context root: a bare `.env` misses apps/api/.env and would copy its
# secrets into the image.
**/.env
**/.env.*
!**/.env.example
.DS_Store

# Editor / tooling
.idea
.vscode

# Repo metadata not needed for the Docker build context
.agents
.cursor
AGENTS.md

# Existing app/package artifacts
apps/*/dist
apps/*/.astro
apps/*/.vite
apps/*/coverage
packages/*/dist
