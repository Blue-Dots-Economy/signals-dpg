# ─── Map Configuration ───────────────────────────────────────────
# Map provider: leaflet (default), google-maps, mapbox
VITE_MAP_PROVIDER=leaflet

# Google Maps API key (required when VITE_MAP_PROVIDER=google-maps)
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox access token (required when VITE_MAP_PROVIDER=mapbox)
VITE_MAPBOX_ACCESS_TOKEN=


# ─── API Configuration ────────────────────────────────────────────
# API base URL for authentication and other endpoints
VITE_API_URL=http://localhost:3000

# Additional API instances (dev mode only, JSON format)
# The dropdown will show these options alongside the default
# Example: {"student":"http://localhost:3001","tutor":"http://localhost:3002"}
VITE_API_URLS=

# Override default API URL (optional)
# If set, this will be used instead of VITE_API_URL as the default option
# VITE_DEFAULT_API_URL=http://localhost:3000

# Show instance selector dropdown in production (for testing)
# Set to 'true' when deploying to Amplify for testing different backends
# VITE_SHOW_INSTANCE_SELECTOR=true

# ─── Network Configuration ─────────────────────────────────────────
# Network id to use (e.g., yellow_dot, blue_dot)
# If empty, shows network selector in sidebar for multi-network setups
# VITE_NETWORK_ID=yellow_dot

# ─── Credential Import Providers ────────────────────────────────────
# Dhiway Wallet configuration
# Required to enable the Dhiway wallet provider in the UI.
VITE_VC_WALLET_URL=
VITE_VC_WALLET_API_KEY=

# DigiLocker configuration
# Required to enable the DigiLocker provider in the UI.
VITE_AGENT_URL=
VITE_AGENT_TOKEN=

# DigiLocker popup callback
# The DigiLocker redirect origin should host the bridge page at:
#   /digilocker-bridge.html
# This repo includes the bridge file at apps/ui/public/digilocker-bridge.html.
VITE_ACTION_POLL_INTERVAL_MS=30000
VITE_DEFAULT_VIEW_MODE=map

# ─── Internationalization (i18n) ──────────────────────────────────
# Comma-separated list of language codes to show in the language dropdown,
# in display order. Each code must match a file in src/i18n/locales/<code>.json.
# If unset, all discovered locale files are shown (dev convenience).
# Example: VITE_ENABLED_LANGUAGES=en,kn,hi
# VITE_ENABLED_LANGUAGES=en,kn,hi

# Optional Photon endpoint for address autocomplete; free key-less fallback
# used when VITE_GOOGLE_MAPS_API_KEY is unset (default: https://photon.komoot.io)
VITE_PHOTON_URL=

# ─── Per-domain UI binding ─────────────────────────────────────────
# Scope this UI deployment to one or more comma-separated network/domain values (e.g. purple_dot/provider).
# When set: pins the network + acting domain, scopes Browse to that domain's
# interaction targets, skips the profile role-picker, hides the network
# selector, blocks cross-domain login, and adds the domain to the tab title.
# Generic — works for any "<network>/<domain>" present in network.json
# (e.g. yellow_dot/teacher). Deploy the same build as N instances, one per
# domain, against the same backend.
# Leave UNSET to serve ALL domains (the combined multi-domain UI, as before).
# In production this is supplied at runtime via config.js
# (window.__DPG_UI_CONFIG__), not baked into the build.
# VITE_SERVED_BINDINGS=purple_dot/provider                         # one entry = single-domain portal
# VITE_SERVED_BINDINGS=yellow_dot/tutor,yellow_dot/coaching_center  # multiple = whitelisted subset (same network)

# ─── Theme / build variants (also undocumented previously) ─────────
# Default network theme used for the data-network attribute on first paint.
# Falls back to the first VITE_NETWORK_ID entry, else 'blue_dot'.
# VITE_DEFAULT_NETWORK_THEME=purple_dot

# Browser tab title for the tourist build (VITE_APP=tourist). Default: OneTAC.
# VITE_TOURIST_APP_TITLE=OneTAC
