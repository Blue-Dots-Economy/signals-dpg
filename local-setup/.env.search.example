# ─────────────────────────────────────────────────────────────────────────────
# signals-search wiring for signals-api  —  OPTIONAL
#
#   cp .env.search.example .env.search
#   docker compose --profile search up -d
#
# Loaded by signals-api through an OPTIONAL env_file, so when this file is absent
# nothing is injected and the default stack is completely unaffected. That
# indirection is deliberate: MATCH_SCORE_PROVIDER is validated as an enum, so an
# EMPTY value is a hard boot failure — and compose's `environment:` mapping has no
# way to omit a key whose interpolated value is blank.
#
# Full walkthrough: LOCAL_SETUP.md §7
# ─────────────────────────────────────────────────────────────────────────────

# ── Discover / relevance-ranked search ──────────────────────────────────────
# Missing or unreachable -> signals-api falls back to the unranked native path
# and the UI shows "Showing basic matches — relevance ranking is temporarily
# unavailable". Use the compose SERVICE NAME and CONTAINER port, not
# localhost:3100 — that mapping is for your browser, not container-to-container.
SIGNALS_SEARCH_URL=http://signals-search-api:3100

# ── Match score ─────────────────────────────────────────────────────────────
# A SEPARATE config block that reads the SAME URL under a DIFFERENT NAME. Any of
# these missing -> every match-score call returns 503 MATCH_SCORE_NOT_CONFIGURED,
# even while discover ranks correctly.
MATCH_SCORE_PROVIDER=signals_search
SIGNALS_SEARCH_ENDPOINT=http://signals-search-api:3100

# ── Shared apikey ───────────────────────────────────────────────────────────
# signals-search has NO api-key env var of its own: it validates this value
# against the `apikey` table in the shared Signals database (enabled, unexpired,
# non-null user_id). Mint one with:
#   docker compose run --rm signals-bootstrap sh -lc "pnpm --filter api db:seed:services"
# It prints an sk_signals_… key ON FIRST RUN ONLY. Paste the RAW key below — the
# database stores only its hash, so a lost key cannot be recovered (re-seed).
SIGNALS_SEARCH_API_KEY=

# ── Optional overrides ──────────────────────────────────────────────────────
# Host port for the search API. The container always listens on 3100.
#SEARCH_API_PORT=3100
# Use a locally built signals-search image instead of the published one.
#SIGNALS_SEARCH_IMAGE=signals-search:local
# Must match the model revision baked into the TEI image, or TEI fails to boot.
#BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181
