{
  "display_name": "Blue Dot",
  "description": "Jobs and hiring network.",
  "schema_standard": "https://json-schema.org/draft/2020-12/schema",
  "domains": [
    {
      "description": "People looking for jobs.",
      "minimum_cache_ttl_seconds": 300,
      "status_rules": [
        { "status": "new",      "label": "New",      "description": "Joined within the last 7 days",            "when": { "item_age_days": { "lte": 7 } } },
        { "status": "active",   "label": "Active",   "description": "Applied to a job in the last 30 days",     "when": { "days_since_last": { "buckets": ["create", "accept"], "lte": 30 } } },
        { "status": "at_risk",  "label": "At Risk",  "description": "No applications for 30–90 days",           "when": { "days_since_last": { "buckets": ["create", "accept", "reject"], "between": [31, 90] } } },
        { "status": "inactive", "label": "Inactive", "description": "No activity 90+ days",                     "when": "default" }
      ],
      "item_schemas": {
        "profile_1.0": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Job Seeker Profile 1.0",
          "display_name_field": "name",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "gender",
            "location",
            "age",
            "phone"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Full Name",
              "minLength": 1
            },
            "gender": {
              "type": "string",
              "title": "Gender",
              "minItems": 1
            },
            "location": {
              "type": "string",
              "title": "Location"
            },
            "phone": {
              "type": "string",
              "title": "Mobile Number",
              "minimum": 10
            },
            "age": {
              "type": "integer",
              "title": "Age",
              "minimum": 14,
              "maximum": 65
            },
            "workExperience": {
              "type": "string",
              "title": "Work Experience",
              "enum": [
                "Fresher",
                "Worked before",
                "Returning after a break"
              ]
            },
            "workExperienceYearsConditional": {
              "type": "string",
              "title": "Years of Work Experience",
              "enum": [
                "0",
                "< 1 Year",
                "1 Year",
                "2 Years",
                "3 Years",
                "3-5 Years",
                "5-10 Years",
                "10-15 Years",
                "15+ Years",
                "Other"
              ]
            },
            "highestQualificationOrSkill": {
              "type": "string",
              "title": "Highest Qualification / Skill",
              "enum": [
                "School",
                "College",
                "ITI / Other Vocational Trainings",
                "Certification / Learned on the job"
              ]
            },
            "natureOfJobsInterestedIn": {
              "type": "string",
              "title": "Nature of Jobs Interested In",
              "enum": [
                "Internship",
                "Apprenticeship",
                "Full-time",
                "Flexible"
              ]
            },
            "nameOfJobRolesInterestedIn": {
              "type": "string",
              "title": "Job Roles Interested In",
              "minLength": 1
            },
            "otherHelpNeeded": {
              "type": "string",
              "title": "Other Help Needed",
              "enum": [
                "Training",
                "Accommodation",
                "Travel",
                "Other"
              ]
            }
          }
        }
      },
      "id": "seeker",
      "card": {
        "title_field": "name",
        "avatar_from": "name",
        "default_fields": ["location", "natureOfJobsInterestedIn", "highestQualificationOrSkill", "workExperience"]
      },
      "dashboard_tiles": {
        "total_items": "Total Job Seekers",
        "complete_profiles": "Profiles Complete",
        "has_applications": "Applied for Jobs"
      }
    },
    {
      "description": "Employers and recruiters posting jobs.",
      "minimum_cache_ttl_seconds": 300,
      "status_rules": [
        { "status": "new",      "label": "New",      "description": "Job posted within the last 7 days",                                "when": { "item_age_days": { "lte": 7 } } },
        { "status": "active",   "label": "Active",   "description": "Received applications and shortlisted or rejected in last 30 days", "when": { "all": [ { "count": { "buckets": ["create"], "gt": 0 } }, { "days_since_last": { "buckets": ["accept", "reject"], "lte": 30 } } ] } },
        { "status": "at_risk",  "label": "At Risk",  "description": "No applications shortlisted or rejected for 30–90 days",            "when": { "all": [ { "count": { "buckets": ["create"], "gt": 0 } }, { "days_since_last": { "buckets": ["accept", "reject"], "between": [31, 90] } } ] } },
        { "status": "inactive", "label": "Inactive", "description": "No activity for 90+ days",                                          "when": "default" }
      ],
      "item_schemas": {
        "job_posting_1.0": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Job Posting 1.0",
          "display_name_field": "jobProviderName",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jobProviderName",
            "role",
            "jobProviderLocation",
            "hiringManagerName",
            "hiringManagerPhoneNumber",
            "hiringManagerEmail",
            "positions",
            "natureOfJob"
          ],
          "properties": {
            "jobProviderName": {
              "type": "string",
              "title": "Company Name",
              "minLength": 1
            },
            "jobProviderLocation": {
              "type": "string",
              "title": "Job Location"
            },
            "hiringManagerName": {
              "type": "string",
              "title": "Hiring Manager Name",
              "minLength": 1
            },
            "hiringManagerPhoneNumber": {
              "type": "string",
              "title": "Hiring Manager Mobile Number"
            },
            "hiringManagerEmail": {
              "type": "string",
              "title": "Hiring Manager Email"
            },
            "role": {
              "type": "string",
              "title": "Role",
              "minLength": 1
            },
            "positions": {
              "type": "integer",
              "title": "Open Positions",
              "minimum": 1
            },
            "natureOfJob": {
              "type": "string",
              "title": "Nature of Job",
              "enum": [
                "Internship",
                "Apprenticeship",
                "Full-time",
                "Flexible"
              ]
            },
            "stipendMin": {
              "type": "number",
              "title": "Monthly In-hand Stipend (INR) min",
              "minimum": 0
            },
            "stipendMax": {
              "type": "number",
              "title": "Monthly In-hand Stipend (INR) max",
              "minimum": 0
            },
            "salaryMin": {
              "type": "number",
              "title": "Monthly In-hand Salary (INR) min",
              "minimum": 0
            },
            "salaryMax": {
              "type": "number",
              "title": "Monthly In-hand Salary (INR) max",
              "minimum": 0
            },
            "taskRateMin": {
              "type": "number",
              "title": "Per Task (INR) min",
              "minimum": 0
            },
            "taskRateMax": {
              "type": "number",
              "title": "Per Task (INR) max",
              "minimum": 0
            },
            "candidateExperienceType": {
              "type": "string",
              "enum": [
                "Fresher",
                "Worked before",
                "Returning after a break"
              ]
            },
            "minEducationalInstitute": {
              "type": "string",
              "enum": [
                "School",
                "College",
                "ITI",
                "Other Vocational Training",
                "Certifications",
                "None"
              ]
            },
            "workExperienceYears": {
              "type": "string",
              "enum": [
                "0",
                "< 1 Year",
                "1 Year",
                "2 Years",
                "3 Years",
                "3-5 Years",
                "5-10 Years",
                "10-15 Years",
                "15+ Years",
                "Other"
              ]
            },
            "lastRoleHeld": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "id": "provider",
      "card": {
        "title_field": "jobProviderName",
        "avatar_from": "jobProviderName",
        "default_fields": ["role", "jobProviderLocation", "natureOfJob", "positions"]
      },
      "dashboard_tiles": {
        "total_items": "Total Job Postings",
        "complete_profiles": "Postings Complete",
        "has_applications": "Received Applications"
      }
    }
  ],
  "instances": [
    {
      "instance_name": "Blue Dot Seeker Local",
      "instance_url": "http://localhost:2742",
      "custom_item_schema_urls": {},
      "domain_id": "seeker"
    },
    {
      "instance_name": "Blue Dot Provider Local",
      "instance_url": "http://localhost:2742",
      "custom_item_schema_urls": {},
      "domain_id": "provider"
    }
  ],
  "actions": {
    "apply": {
      "description": "Lets a seeker and provider to invite each other.",
      "interactions": [
        {
          "from_network": "blue_dot",
          "from_domain": "seeker",
          "to_network": "blue_dot",
          "to_domain": "provider",
          "requirement_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Job Application Requirement",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "workExperience",
              "age"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "age": {
                "type": "integer",
                "minimum": 14,
                "maximum": 65
              },
              "workExperience": {
                "type": "string",
                "enum": [
                  "Fresher",
                  "Worked before",
                  "Returning after a break"
                ]
              }
            }
          },
          "event_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Job Application Event",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "remark"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "created",
                  "submitted",
                  "shortlisted",
                  "rejected"
                ]
              },
              "remark": {
                "type": "string"
              }
            }
          },
          "metric_categories": {
            "create": ["created", "submitted"],
            "accept": ["shortlisted"],
            "reject": ["rejected"],
            "cancel": []
          },
          "reveals_pii_on_status": ["shortlisted"],
          "consent_text_initiator": "I agree to share my profile contact details with this organization if my application is accepted.",
          "consent_text_receiver": "I agree to share my organisation's contact details with the applicant."
        },
        {
          "from_network": "blue_dot",
          "from_domain": "provider",
          "to_network": "blue_dot",
          "to_domain": "seeker",
          "requirement_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Interview Invitation Requirement",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "interview_time",
              "interview_mode"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "interview_time": {
                "type": "string",
                "format": "date-time"
              },
              "interview_mode": {
                "type": "string",
                "enum": [
                  "in_person",
                  "online",
                  "phone"
                ]
              },
              "message_to_candidate": {
                "type": "string"
              }
            }
          },
          "event_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Interview Invitation Event",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "remark"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "created",
                  "invited",
                  "accepted",
                  "rejected"
                ]
              },
              "remark": {
                "type": "string"
              }
            }
          },
          "metric_categories": {
            "create": ["created", "invited"],
            "accept": ["accepted"],
            "reject": ["rejected"],
            "cancel": []
          },
          "reveals_pii_on_status": ["accepted"],
          "consent_text_initiator": "I agree to share my profile contact details with this organization if my application is accepted.",
          "consent_text_receiver": "I agree to share my organisation's contact details with the applicant."
        }
      ]
    },
    "connect": {
      "description": "Lets a provider connect with another provider (partnership / referral). Either party can initiate; the receiver can accept or reject.",
      "interactions": [
        {
          "from_network": "blue_dot",
          "from_domain": "provider",
          "to_network": "blue_dot",
          "to_domain": "provider",
          "requirement_schema": { "type": "object", "properties": {} },
          "event_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Provider To Provider Connect Event",
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "remark"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["created", "accepted", "rejected", "cancelled"]
              },
              "remark": { "type": "string" }
            }
          },
          "metric_categories": null,
          "reveals_pii_on_status": ["accepted"],
          "consent_text_initiator": "I agree to share my organisation's contact details with this organisation if they accept my request.",
          "consent_text_receiver": "I agree to share my organisation's contact details with the requester."
        }
      ]
    }
  },
  "id": "blue_dot",
  "dashboard_buckets": {
    "by_status": {
      "new": "New",
      "active": "Active",
      "at_risk": "At Risk",
      "inactive": "Inactive"
    },
    "by_action_status": {
      "create": "Applied",
      "accept": "Shortlisted",
      "reject": "Rejected",
      "cancel": "Withdrawn"
    }
  }
}
