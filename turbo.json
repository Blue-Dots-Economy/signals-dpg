{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_*",
    "PUBLIC_*",
    "ASTRO_*"
  ],
  "globalPassThroughEnv": [
    "ALLOWED_ORIGINS",
    "ALLOW_EXTRA_SCHEMA_DATA",
    "BULK_MAX_ITEMS",
    "MAX_WARDS_PER_GUARDIAN",
    "MAX_PROFILES_PER_USER",
    "API_DOMAIN",
    "API_PORT",
    "AUTH_MIDDLEWARE_ENABLED",
    "AUTH_SECRET",
    "CREATE_TEST_OTP",
    "DATABASE_PORT",
    "DPG_SCORING_*",
    "FRONTEND_BASE_URL",
    "GOOGLE_GEOCODING_API_KEY",
    "INSTANCE_ENV",
    "INSTANCE_NAME",
    "INGEST_STREAM",
    "INGEST_STREAM_MAXLEN",
    "INSTANCE_SHARED_SECRET",
    "LOGIN_CHANNELS",
    "MATCH_SCORE_PROVIDER",
    "CONSENT_CONFIG_*",
    "CONSENT_SUPPORT_EMAIL",
    "NETWORK_CONFIG_*",
    "NOTIFICATION_*",
    "PEER_AUTH_MODE",
    "PEER_FETCH_TIMEOUT_MS",
    "PHOTON_URL",
    "PII_LOCATION_JITTER_MIN_METERS",
    "PII_LOCATION_JITTER_MAX_METERS",
    "POSTGRES_*",
    "REDIS_*",
    "SCHEMA_REGISTRY_URL",
    "SELF_SIGNUP_MODE",
    "SERVED_DOMAINS",
    "SIGNALS_PII_KEY",
    "SMS_TEMPLATE_ID",
    "SUPPORT_CC_EMAIL",
    "SUPPORT_EMAIL"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:tourist": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/tourist/**"
      ]
    },
    "dev": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false,
      "persistent": true
    },
    "dev:tourist": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "start": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "db:pull": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false
    },
    "db:push": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false
    },
    "db:generate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false
    },
    "db:migrate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false
    },
    "db:studio": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false
    }
  }
}
