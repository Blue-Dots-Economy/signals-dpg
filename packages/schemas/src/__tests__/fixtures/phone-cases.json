    { "input": "+4479111234567", "countries": ["IN", "GB", "AU"], "kind": "mobile", "reason": "invalid" },
    { "input": "+61412345678", "countries": ["IN"], "kind": "mobile", "reason": "country_not_allowed", "message": "phone numbers starting +61 are not accepted" },
    { "input": "+447911123456", "countries": ["GB", "IN"], "kind": "mobile", "value": "+447911123456" },
