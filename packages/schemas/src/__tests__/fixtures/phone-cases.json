    { "input": "(987) 654 3210", "countries": ["IN"], "kind": "mobile", "value": "+919876543210" },
    { "input": "09876543210", "countries": ["IN"], "kind": "mobile", "value": "+919876543210" },
    { "input": "00919876543210", "countries": ["IN"], "kind": "mobile", "value": "+919876543210" },
    { "input": "919876543210", "countries": ["IN"], "kind": "mobile", "value": "+919876543210" },
    { "input": "+91 09876 543210", "countries": ["IN"], "kind": "mobile", "value": "+919876543210" },
